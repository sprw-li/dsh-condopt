{
  "name": "dsh-condopt",
  "version": "0.4.0",
  "private": false,
  "description": "把 condopt 的条件优化内容视图搬进 DeepSeek Harness：右侧栏面板 + /condopt 命令 + 只读工具 condopt_view；前端骨架复用 dsh-model-council。",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sprw-li/dsh-condopt.git"
  },
  "homepage": "https://github.com/sprw-li/dsh-condopt",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "condopt",
    "bayesian-optimization",
    "experiment-design"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "syntax": "node --check index.js && node --check client.js",
    "verify": "node dev/verify-host.mjs && node dev/verify-client.mjs",
    "verify:host": "node dev/verify-host.mjs",
    "verify:client": "node dev/verify-client.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
